# Template for .env — copy it, then fill in real values:  cp .env.example .env
#
# Purpose: this file is committed and .env is not. It documents every setting
# the app needs, so a new contributor can see what to provide without ever
# seeing anyone's real values. Add a line here whenever you add a setting.

# ------------------ DATABASE ------------------
# Read by app/config.py into the Settings object.
# For local development with docker-compose:
#   USER, PASSWORD and DATABASE are all "paideia", and HOST is "localhost".
# The "+psycopg" part names the Python driver and is easy to get wrong, so it
# is left concrete rather than replaced with a placeholder.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

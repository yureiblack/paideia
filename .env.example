# Template for .env — copy it, then fill in real values:  cp .env.example .env
#
# Purpose: this file is committed and .env is not. It documents every setting
# the app needs, so a new contributor can see what to provide without ever
# seeing anyone's real values. Add a line here whenever you add a setting.


# ------------------ DATABASE ------------------
# Read by app/config.py into the Settings object.
# For local development with docker-compose:
#   USER, PASSWORD and DATABASE are all "paideia", and HOST is "localhost".
# The "+psycopg" part names the Python driver and is easy to get wrong, so it
# is left concrete rather than replaced with a placeholder.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# ------------------ CORS ------------------
# Browser origins allowed to call the API, comma-separated, no quotes.
# Optional. When unset, only the local frontend at http://localhost:3000 is
# allowed.
# CORS_ORIGINS=http://localhost:3000

# ------------------ FRONTEND ------------------
# Where the browser finds the API. Optional. When unset it is
# http://localhost:8000. Read by web/src/lib/config.ts and baked into the
# frontend when it is built or when `pnpm dev` starts, so restart the dev server
# after changing it. Next.js normally reads env files only inside web/;
# web/next.config.ts loads this root file instead, so everything stays here.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ------------------ UPLOADS ------------------
# Folder where uploaded PDFs are stored, one subfolder per environment.
# Optional. When unset it is data/ at the repository root. A relative path is
# taken from the repository root as well.
# DATA_DIR=data
#
# Largest PDF accepted, in megabytes. Optional; 50 when unset.
# MAX_UPLOAD_MB=50

# ------------------ EMBEDDINGS ------------------
# The local model that turns text into vectors for semantic search. Optional.
# Changing it to a model of another size also needs a database migration,
# because the vector column has a fixed size.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIMENSIONS=384
#
# Where downloaded models are kept, so each is fetched only once. Optional;
# data/models when unset.
# MODEL_DIR=data/models
#
# The model that reorders search results by reading the query and each
# passage together. Optional.
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ------------------ SEARCH ------------------
# How many chunks each stage of a search considers. Optional; these are the
# defaults. Keyword and semantic search each find their best TOP_K chunks,
# the merged list's best CANDIDATE_POOL are reranked, and a search returns
# FINAL_K results unless it asks for another number (at most 50).
# RETRIEVAL_TOP_K_LEXICAL=30
# RETRIEVAL_TOP_K_DENSE=30
# RETRIEVAL_CANDIDATE_POOL=30
# RETRIEVAL_FINAL_K=10

# ------------------ LANGUAGE MODEL ------------------
# The local language model, served by Ollama (https://ollama.com), which runs
# on this machine outside Docker. Install and start it with
#   brew install ollama && brew services start ollama
# and download the model once with: ollama pull ministral-3:8b
# Optional; these are the defaults.
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=ministral-3:8b
# How much text the model reads at once, in tokens (about 4 characters each).
# LLM_CONTEXT_TOKENS=16384
# How long one request may take, and how often a failed one is retried.
# LLM_TIMEOUT_SECONDS=300
# LLM_MAX_RETRIES=2

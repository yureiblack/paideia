                          "fill": "$text",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "This material covers how operating systems manage CPU scheduling, memory allocation, and synchronization to coordinate processes and threads efficiently. It explains scheduling algorithms like round robin and shortest job first, synchronization mechanisms such as mutexes and semaphores, and memory management techniques like paging and page replacement.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-sans",
                          "fontSize": 18,
                          "fontWeight": "normal",

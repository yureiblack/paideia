                                      "type": "text",
                                      "id": "PosEi",
                                      "name": "T",
                                      "fill": "$bs-ink",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "Round robin scheduling assigns each ready task a fixed time quantum, typically 10 to 100 milliseconds. When the quantum expires, the running task is preempted and moved to the back of the ready queue, and the dispatcher selects the task at the head of the queue.",
                                      "lineHeight": 1.6,
                                      "fontFamily": "$bs-text",
                                      "fontSize": 14,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "text",
                                  "id": "QITUh",
                                  "name": "After",
                                  "fill": "$bs-ink-2",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "The performance of round robin depends heavily on the size of the time quantum. If the quantum is extremely large, the policy is the same as first come, first served.",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$bs-text",
                                  "fontSize": 14,
                                  "fontWeight": "normal"
                                }
                              ]
